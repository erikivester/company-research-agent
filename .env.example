# ===== API Keys =====
TAVILY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ===== ngrok (Required for Docker setup) =====
# Get your token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ===== Database =====
MONGO_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=company_research

# ===== Security =====
JWT_SECRET_KEY=your-secret-key-here-change-in-production
API_KEY=your-api-key-here

# ===== Airtable =====
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=

# ===== Google Drive (Optional) =====
EMAIL_TEMPLATES_FOLDER_ID=1tt4LLouNP2FgHcguIKlnRzRb3j5jE8LH
GDRIVE_CREDENTIALS_PATH=/secrets/gdrive_credentials.json

# ===== Server Configuration =====
PORT=8000
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ===== Feature Flags =====
ENABLE_AIRTABLE_UPLOAD=false
ENABLE_GDRIVE_UPLOAD=false